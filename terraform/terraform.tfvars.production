# Production Terraform Variables
# IMPORTANT: This file should NOT be committed to version control
# Copy this to terraform.tfvars and fill in actual values

# AWS Account ID - Your production AWS account ID
aws_account_id = ""

# Database password - Use a strong, unique password
# Consider using AWS Secrets Manager instead of hardcoding
db_password = ""

# AWS Region for production deployment
aws_region = "us-east-1"

# VPC CIDR - Ensure this doesn't overlap with other VPCs
vpc_cidr = "10.0.0.0/16"

# Public Subnet CIDRs - For ALB and bastion hosts
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]

# Private Subnet CIDRs - For ECS tasks and RDS
private_subnet_cidrs = ["10.0.3.0/24", "10.0.4.0/24"]

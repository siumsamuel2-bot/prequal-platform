{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd prequal-platform && npm ci",
  "buildCommand": "cd prequal-platform && npm run build",
  "outputDirectory": "prequal-platform/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://prequal-staging-api.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

# Prequal Platform - Development Environment Variables
# Copy this file to .env and fill in your values
# IMPORTANT: Do not use these default values in production

# === Database ===
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=prequal

# === Backend (FastAPI) ===
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-base64-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Frontend (Vite) ===
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Prequal Platform

# === Optional: OSHA API ===
# OSHA_API_KEY=your_osha_api_key_here

# === CORS ===
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=your_smtp_password
# EMAIL_FROM=noreply@example.com

# === Analytics Service (MID-588) ===
# Shared key for service-to-service authentication with analytics-service
SERVICE_API_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# Monolith delegation to the extracted analytics service (Strangler Fig)
# ANALYTICS_SERVICE_URL=http://analytics:8006
# ANALYTICS_SERVICE_API_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# === Rate Limiting & DDoS Protection (MID-593) ===
# Shared storage + dynamic config persistence (strongly recommended in production)
# REDIS_URL=redis://localhost:6379/0
# JSON file to persist admin rate-limit changes
# RATE_LIMIT_CONFIG_FILE=./logs/rate_limit_config.json
# Optional webhook notified when an IP is auto-banned
# RATE_LIMIT_ALERT_WEBHOOK=
# DDOS_MAX_BODY_BYTES=10485760
# DDOS_MAX_QUERY_LENGTH=2048
# DDOS_MAX_QUERY_PARAMS=50
# DDOS_MAX_HEADER_COUNT=100
# DDOS_MAX_CONCURRENT_PER_IP=50
# DDOS_VIOLATION_THRESHOLD=20
# DDOS_BAN_SECONDS=300


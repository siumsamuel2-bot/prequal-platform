# Prequal Platform - Staging Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# SECURITY - Generate secure random values
# ===========================================

# Secret key for JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-in-production

# Database password
POSTGRES_PASSWORD=staging-db-password-change-me

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/prequal_staging

# ===========================================
# REDIS
# ===========================================
REDIS_URL=redis://redis:6379/0

# ===========================================
# APPLICATION
# ===========================================
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

# ===========================================
# CORS - Allowed origins (comma-separated)
# Values are browser ORIGINS (scheme + host), not API base URLs.
# Matches the Render blueprint ALLOWED_ORIGINS (MID-680).
# ===========================================
ALLOWED_ORIGINS=https://prequal-staging.vercel.app,http://localhost:3000,http://localhost:80

# ===========================================
# FRONTEND BUILD (Vite - baked in at build time)
# For the Vercel-hosted frontend; the /api suffix is required because
# all backend routers mount under /api/... (see docs/staging-free-tier.md)
# ===========================================
VITE_API_URL=http://localhost:8000/api
# No analytics WebSocket endpoint exists yet (MID-592): leave unset and the
# dashboards fall back to interval polling (src/hooks/useRealtimeConnection.ts)
# VITE_ANALYTICS_WS_URL=wss://prequal-staging-api.onrender.com/<path>

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# OSHA API (Optional - for safety data)
# ===========================================
OSHA_API_KEY=

# ===========================================
# EMAIL/SMTP (Optional - for alerts)
# ===========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@prequal.local

# ===========================================
# PGADMIN (Database UI)
# ===========================================
PGADMIN_EMAIL=admin@prequal.local
PGADMIN_PASSWORD=admin-password-change-me

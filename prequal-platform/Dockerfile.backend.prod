# syntax=docker/dockerfile:1
# Dockerfile for Prequal Platform FastAPI Backend - Production
# Optimized for size, build speed, and security

# Stage 1: Build environment
FROM python:3.11-alpine AS builder

WORKDIR /app

# Install build dependencies only
RUN apk add --no-cache --virtual .build-deps \
    build-base \
    postgresql-dev \
    libffi-dev

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies to virtual environment
# Uses pip cache mount for faster rebuilds
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m venv /opt/venv && \
    . /opt/venv/bin/activate && \
    pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Remove build dependencies
RUN apk del .build-deps

# Stage 2: Production image
FROM python:3.11-alpine AS production

# Security: Create non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# Install runtime dependencies only
RUN apk add --no-cache \
    curl \
    postgresql-libs \
    libffi

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code (grouped for fewer layers)
COPY --chown=appuser:appgroup \
    requirements.txt \
    alembic.ini \
    ./
COPY --chown=appuser:appgroup \
    app/ ./app/ \
    api/ ./api/ \
    alembic/ ./alembic/

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PATH="/opt/venv/bin:$PATH"

# Security: Use non-root user
USER appuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run migrations and start application
CMD ["sh", "-c", "alembic upgrade head && uvicorn api.main:app --host 0.0.0.0 --port 8000"]

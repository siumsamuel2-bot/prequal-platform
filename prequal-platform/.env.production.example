# Production Environment Configuration
# NEVER commit this file to version control
# Copy to .env.production and configure for your environment

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=production

# =============================================================================
# SECURITY - Generate secure random values
# =============================================================================
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<64-character-hex-string>

# Production domain(s) for CORS
ALLOWED_ORIGINS=https://prequal.yourcompany.com

# =============================================================================
# DATABASE
# =============================================================================
# Generate POSTGRES_PASSWORD: openssl rand -base64 32
POSTGRES_PASSWORD=<32-character-random-string>

# =============================================================================
# EMAIL (SMTP) - Configure with your email provider
# =============================================================================
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=noreply@yourcompany.com
SMTP_PASSWORD=<app-password-from-email-provider>
EMAIL_FROM=noreply@yourcompany.com

# =============================================================================
# OSHA API - Get from OSHA API portal
# =============================================================================
OSHA_API_KEY=<your-osha-api-key>

# =============================================================================
# PGADMIN (optional - for database management)
# =============================================================================
PGADMIN_EMAIL=admin@yourcompany.com
PGADMIN_PASSWORD=<strong-password>

# =============================================================================
# ADDITIONAL NOTES
# =============================================================================
# 1. Copy this file to .env.production
# 2. Replace all <placeholder> values with actual secrets
# 3. Set file permissions: chmod 600 .env.production
# 4. Never commit .env.production to version control
# 5. Store production secrets in a secure secret manager
# 6. Rotate secrets regularly (quarterly recommended)

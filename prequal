# Traefik Configuration for Production
# This file configures Traefik as a reverse proxy with automatic SSL

api:
  dashboard: true
  insecure: false

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true

  websecure:
    address: ":443"
    http:
      tls:
        certResolver: letsencrypt

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: prequal-network

  file:
    filename: /etc/traefik/dynamic.yml
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: admin@yourcompany.com  # Replace with your email
      storage: /etc/traefik/acme.json
      httpChallenge:
        entryPoint: web

# Optional: Enable access logs
accessLog:
  filePath: "/var/log/traefik/access.log"
  bufferingSize: 100

# Optional: Enable Traefik logs
log:
  filePath: "/var/log/traefik/traefik.log"
  level: "INFO"
